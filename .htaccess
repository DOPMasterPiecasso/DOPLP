RewriteEngine On
DirectoryIndex index.php index.html

# /login -> /backend/admin/login.php (harus sebelum aturan .html)
RewriteRule ^login/?$ backend/admin/login.php [L]
RewriteRule ^logout/?$ backend/admin/logout.php [L]
RewriteRule ^admin/?$ backend/admin/dashboard.php [L]
RewriteRule ^dashboard/?$ backend/admin/dashboard.php [L]

# /sitemap.xml -> /sitemap.xml.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /blog -> /blog.php  dan  /blog/<slug> -> /blog-detail.php
RewriteRule ^blog/?$ blog.php [L]
RewriteRule ^blog/([A-Za-z0-9\-_]+)/?$ blog-detail.php?slug=$1 [L]

# /portfolio -> /portfolio.php
RewriteRule ^portfolio/?$ portfolio.php [L]

# /about -> /about.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
